{
	"name": "practice-coach",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.12.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @coach/api --filter @coach/web dev",
		"lint": "eslint .",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2"
	}
}
