# Every variable has a default, so `pnpm dev` works with no .env.
# There is no dotenv: to change a value, export it in your shell.

# Host the api binds to.
HOST=localhost
# Path prefix of every api route.
BASE_API=/api
# Port of each app. Leave it unset when running both with `pnpm dev`: api defaults to 3001, web to 3000.
# PORT=
# Where the web server finds the api.
API_URL=http://localhost:3001
# How long the web server waits for the api. Keep it longer than LLM_TIMEOUT_MS, or the web gives up before the api can fall back.
WEB_API_TIMEOUT_MS=8000
# Demo aid only: lets the page pick the student with ?student_id=. It MUST be "off" in any real deployment,
# because the student id has to come from the signed-in account, never from the URL.
DEMO_STUDENT_SWITCHER=on
# Student shown when the switcher is off or the requested id is not valid.
DEFAULT_STUDENT_ID=stu_1041

# "ollama" calls a local model; "none" always uses the deterministic fallback.
LLM_PROVIDER=ollama
# Address of the local Ollama server.
OLLAMA_URL=http://localhost:11434
# Model that Ollama runs.
OLLAMA_MODEL=qwen2.5:3b
# How long to wait for the model before using the fallback.
LLM_TIMEOUT_MS=6000
