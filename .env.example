# Defaults apply when a variable is unset. There is no dotenv: export these in your shell.
# PORT is read by each app on its own: api defaults to 3001, web to 3000. Leave it unset
# when running both with `pnpm dev`.
# PORT=
API_URL=http://localhost:3001

# "ollama" calls a local model; "none" always uses the deterministic fallback.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_MS=4000
